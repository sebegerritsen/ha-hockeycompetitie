{
  "config": {
    "step": {
      "user": {
        "title": "Find your club",
        "description": "Data comes from the KNHB match centre on hockey.nl. No account is needed.",
        "data": {
          "query": "Club name or town"
        },
        "data_description": {
          "query": "For example a part of the club's name, or the town it plays in."
        }
      },
      "club": {
        "title": "Pick the club",
        "data": {
          "club_id": "Club"
        }
      },
      "team": {
        "title": "Pick the team",
        "description": "Teams of {club}. Add each team you want to follow separately, for example a field and an indoor team.",
        "data": {
          "team_id": "Team"
        },
        "data_description": {
          "team_id": "Field (Veld) or indoor (Zaal), and the age group."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the KNHB match data. Try again later.",
      "rate_limited": "The KNHB match data is busy (too many requests from this network). Wait a minute and try again.",
      "no_clubs_found": "No club found. Try a shorter part of the name, or the town."
    },
    "abort": {
      "already_configured": "This team is already set up.",
      "no_teams": "{club} has no teams with a competition at the moment."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Meet time",
        "description": "When the team meets before kick-off. Used for the meet time sensor and in change alerts.",
        "data": {
          "meet_minutes_home": "Home matches (minutes before kick-off)",
          "meet_minutes_away": "Away matches (minutes before kick-off)"
        },
        "data_description": {
          "meet_minutes_home": "For example 30: meet at 11:30 for a 12:00 match.",
          "meet_minutes_away": "Travel time is not included: this is when you need to be at the venue."
        }
      }
    }
  },
